import Link from "next/link";
import { notFound } from "next/navigation";
import { FontAwesomeIcon } from "@fortawesome/react-fontawesome";
import { faIdCard, faPhone, faEnvelope, faFileInvoice } from "@fortawesome/free-solid-svg-icons";
import { getBooking, getGuestBookingsByPhone } from "@/lib/api-client";
import { StatusBadge } from "@/components/ui/StatusBadge";
import type { Guest } from "@/types/booking";

const ID_TYPE_LABELS: Record<NonNullable<Guest["idType"]>, string> = {
  aadhaar: "Aadhaar",
  passport: "Passport",
  driving_license: "Driving licence",
  voter_id: "Voter ID",
  other: "Other ID",
};

export default async function GuestProfilePage({ params }: { params: Promise<{ id: string }> }) {
  const { id } = await params;
  const booking = await getBooking(id);
  if (!booking) notFound();

  const { guest } = booking;
  const history = getGuestBookingsByPhoneMock(guest.phone).filter((b) => b.id !== booking.id);

  return (
    <div className="flex flex-col gap-6 max-w-2xl">
      <div>
        <h1 className="text-xl font-semibold">{guest.name}</h1>
        <p className="text-sm text-neutral-500">Guest profile</p>
      </div>

      <div className="rounded-lg border border-neutral-200 bg-white p-6 flex flex-col gap-3">
        <div className="flex items-center gap-3 text-sm">
          <FontAwesomeIcon icon={faPhone} className="h-4 w-4 text-neutral-400" />
          <span className="font-mono">{guest.phone}</span>
        </div>
        {guest.email && (
          <div className="flex items-center gap-3 text-sm">
            <FontAwesomeIcon icon={faEnvelope} className="h-4 w-4 text-neutral-400" />
            <span>{guest.email}</span>
          </div>
        )}
        <div className="flex items-center gap-3 text-sm">
          <FontAwesomeIcon icon={faIdCard} className="h-4 w-4 text-neutral-400" />
          {guest.idType && guest.idNumber ? (
            <span>
              {ID_TYPE_LABELS[guest.idType]} · <span className="font-mono">{guest.idNumber}</span>
            </span>
          ) : (
            <span className="text-neutral-400">KYC not captured yet</span>
          )}
        </div>
      </div>

      <div>
        <h2 className="text-sm font-medium text-neutral-500 mb-3">
          Booking history {history.length > 0 && `(${history.length} other visit${history.length > 1 ? "s" : ""})`}
        </h2>
        <div className="flex flex-col gap-3">
          <div className="rounded-lg border border-neutral-200 bg-white p-4 flex items-center justify-between">
            <div>
              <div className="font-medium">
                Room {booking.roomNumber} · <span className="font-mono">{booking.checkIn}</span> →{" "}
                <span className="font-mono">{booking.checkOut}</span>
              </div>
              <div className="text-sm text-neutral-500">This booking</div>
              {booking.notes && <div className="text-sm text-neutral-500 mt-1 italic">&quot;{booking.notes}&quot;</div>}
            </div>
            <div className="flex items-center gap-4">
              <StatusBadge status={booking.status} />
              <Link
                href={`/bookings/${booking.id}/folio`}
                className="text-neutral-500 hover:text-neutral-900"
                title="View folio"
              >
                <FontAwesomeIcon icon={faFileInvoice} className="h-3.5 w-3.5" />
              </Link>
            </div>
          </div>

          {history.map((past) => (
            <div key={past.id} className="rounded-lg border border-neutral-200 bg-white p-4 flex items-center justify-between">
              <div>
                <div className="font-medium">
                  Room {past.roomNumber} · <span className="font-mono">{past.checkIn}</span> →{" "}
                  <span className="font-mono">{past.checkOut}</span>
                </div>
                <div className="text-sm text-neutral-500 font-mono">₹{past.amount.toLocaleString("en-IN")}</div>
              </div>
              <div className="flex items-center gap-4">
                <StatusBadge status={past.status} />
                <Link
                  href={`/bookings/${past.id}/folio`}
                  className="text-neutral-500 hover:text-neutral-900"
                  title="View folio"
                >
                  <FontAwesomeIcon icon={faFileInvoice} className="h-3.5 w-3.5" />
                </Link>
              </div>
            </div>
          ))}

          {history.length === 0 && <p className="text-sm text-neutral-400">No other visits on record.</p>}
        </div>
      </div>
    </div>
  );
}
