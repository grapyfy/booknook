// The database's real schema. Changes here go through `npm run db:migrate`,
// which creates a tracked, numbered migration file — never hand-edit the database directly.
// This is the fix for the exact mistake made on the last project: schema changes patched
// live in prod with one-off scripts instead of tracked migrations. See CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per staff login. `supabaseUserId` links to Supabase Auth's own user record —
// that's what actually handles passwords/sessions; this table just says who they are
// and what they're allowed to do once logged in.
model Staff {
  id             String    @id @default(uuid())
  supabaseUserId String    @unique
  name           String
  email          String    @unique
  role           StaffRole
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  assignedHousekeepingTasks HousekeepingTask[]
  assignedMaintenanceTickets MaintenanceTicket[]
}

// All 6 roles from the PRD are listed so the schema doesn't need a migration later.
// Housekeeping roles are now enforced (2026-09-08, module built) — OWNER, FRONT_DESK,
// HOUSEKEEPING_SUPERVISOR, HOUSEKEEPING_STAFF. ACCOUNTANT stays reserved — no
// accountant-only screens exist yet, nothing to gate.
enum StaffRole {
  OWNER // combines PRD's Super Admin + Property Manager for v1 (single property, no chain yet)
  FRONT_DESK
  ACCOUNTANT // reserved — no accountant-only screens built yet
  HOUSEKEEPING_SUPERVISOR
  HOUSEKEEPING_STAFF
}

model Room {
  id         String   @id @default(uuid())
  roomNumber String   @unique
  roomType   String   // e.g. "Standard", "Deluxe" — free text for v1, not an enum (hotels name these differently)
  ratePerNight Int    // rupees — the actual source of truth bookingService looks up, no more hardcoded rate
  active     Boolean  @default(true) // false = under maintenance / not sellable, without deleting booking history
  createdAt  DateTime @default(now())

  housekeepingTasks  HousekeepingTask[]
  maintenanceTickets MaintenanceTicket[]
}

model Guest {
  id       String      @id @default(uuid())
  name     String
  phone    String
  email    String?
  // Digital KYC (contract addition from the UI branch, 2026-09-08) — both optional,
  // a guest can be created before ID is captured (e.g. a phone booking) and filled in later.
  idType   GuestIdType?
  idNumber String?
  bookings Booking[]

  @@index([phone])
}

enum GuestIdType {
  AADHAAR
  PASSPORT
  DRIVING_LICENSE
  VOTER_ID
  OTHER
}

// A set of bookings taken together (e.g. a family/wedding party across several rooms).
// Deliberately its own table rather than a loose groupId+groupName string repeated on
// every booking row — a shared name that could drift out of sync between rows on an edit
// is exactly the kind of denormalization bug this project's rules exist to avoid.
model BookingGroup {
  id        String    @id @default(uuid())
  name      String
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model Booking {
  id              String        @id @default(uuid())
  guest           Guest         @relation(fields: [guestId], references: [id])
  guestId         String
  checkIn         DateTime
  checkOut        DateTime
  roomNumber      String
  status          BookingStatus @default(CONFIRMED)
  // The rate actually applied to THIS booking (list rate, or a front-desk override —
  // see bookingService's pricing-control logic). GST slab and the folio both key off
  // this stored value, never a live re-lookup of the room's current rate — so a later
  // rate change never silently alters an already-made booking's tax bracket.
  roomRatePerNight Int
  amount          Int           // (roomRatePerNight * nights) - discountAmount, always computed server-side — never accepted from the client
  createdAt       DateTime      @default(now())
  folio           Folio?

  // Front-desk depth (contract additions from the UI branch, 2026-09-08) — all optional/additive.
  source          BookingSource?
  notes           String?
  group           BookingGroup?  @relation(fields: [groupId], references: [id])
  groupId         String?
  paymentStatus   PaymentStatus? // absent = unknown/legacy row — services default this to POSTPAID on read, never write a guess
  discountAmount  Int?           // flat rupee discount applied at booking time, already netted into `amount`; kept separately so the folio can show it as a line item
  priceNote       String?        // free-text reason for a manual rate override/discount — audit trail only, never used in any calculation
  extraServices   ExtraService[]

  @@index([guestId])
  @@index([checkIn, checkOut])
  @@index([roomNumber])
  @@index([groupId])
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
  WAITLISTED
  NO_SHOW
}

enum BookingSource {
  DIRECT
  WALK_IN
  PHONE
  OTHER
}

enum PaymentStatus {
  PREPAID
  POSTPAID
  PARTIAL
}

// One add-on charge against a booking (room service, laundry, minibar...).
// Deliberately NOT folded into `Booking.amount` (room charges only, the GST-relevant
// figure) — see billingService's note on why these don't flow into the folio yet.
model ExtraService {
  id        String   @id @default(uuid())
  booking   Booking  @relation(fields: [bookingId], references: [id])
  bookingId String
  name      String
  amount    Int
  createdAt DateTime @default(now())

  @@index([bookingId])
}

// One GST-compliant bill per booking. Numbers are stored, not recomputed on read —
// a GST rate change in the future must never alter an already-issued invoice.
model Folio {
  id            String   @id @default(uuid())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingId     String   @unique
  invoiceNumber String   @unique
  sacCode       String   @default("996311") // Accommodation services — fixed for this business type
  baseAmount    Int      // pre-tax, rupees
  gstRate       Int      // 12 or 18, based on roomRatePerNight at the time of billing
  gstType       GstType  // CGST_SGST (intra-state) or IGST (inter-state)
  cgst          Int      // 0 if gstType is IGST
  sgst          Int      // 0 if gstType is IGST
  igst          Int      // 0 if gstType is CGST_SGST
  totalAmount   Int      // baseAmount + tax
  createdAt     DateTime @default(now())
}

enum GstType {
  CGST_SGST
  IGST
}

// OTA channel-manager configuration. This table is a REAL, working CRUD layer —
// but "CONNECTED" here records that outreach/setup happened, not a live two-way
// sync with the OTA's servers (that needs actual API access — see CLAUDE.md's
// "OTA integration" section, the BD/outreach track vs. the engineering track).
// Don't wire this to a real MakeMyTrip/Goibibo API without that access confirmed first.
model Channel {
  id        String        @id @default(uuid())
  name      String        @unique // e.g. "MakeMyTrip", "Goibibo", "Booking.com"
  status    ChannelStatus @default(NOT_CONNECTED)
  notes     String?       // manual notes on outreach/negotiation status
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
}

enum ChannelStatus {
  NOT_CONNECTED
  IN_PROGRESS // outreach/negotiation started
  CONNECTED
}

// Banquet/event space — a separate sellable unit from a Room, with its own booking
// concept (HallEvent) rather than reusing Booking, since a hall is priced/booked
// per-event, not per-night, and doesn't participate in GST accommodation billing.
model Hall {
  id           String      @id @default(uuid())
  name         String
  capacity     Int
  ratePerEvent Int         // rupees — flat rate per event, not per-night like a Room
  active       Boolean     @default(true)
  createdAt    DateTime    @default(now())
  events       HallEvent[]
}

model HallEvent {
  id         String          @id @default(uuid())
  hall       Hall            @relation(fields: [hallId], references: [id])
  hallId     String
  eventName  String
  contactName String
  contactPhone String
  startsAt   DateTime
  endsAt     DateTime
  status     HallEventStatus @default(CONFIRMED)
  amount     Int             // hall.ratePerEvent at time of booking — computed server-side, same rule as Booking.amount
  createdAt  DateTime        @default(now())

  @@index([hallId])
  @@index([startsAt, endsAt])
}

enum HallEventStatus {
  CONFIRMED
  CANCELLED
}

// One row per active room per day — cleanliness is a sequence of tasks over time,
// not a static property of a Room, so it's its own table with a real FK to Room
// (the UI branch's mock version used a loose room-number string; a real relation
// is the correct version now that Room is a real table, per "logically right, edge
// cases" — a room getting renumbered/deleted shouldn't silently orphan its history
// via a string match).
model HousekeepingTask {
  id             String              @id @default(uuid())
  room           Room                @relation(fields: [roomId], references: [id])
  roomId         String
  date           DateTime            @db.Date // the day this task is for — one task per room per day
  status         HousekeepingStatus  @default(DIRTY)
  assignedTo     Staff?              @relation(fields: [assignedToId], references: [id])
  assignedToId   String?
  priority       TaskPriority        @default(NORMAL)
  notes          String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@unique([roomId, date]) // enforces "one task per room per day" at the database level, not just in application code
  @@index([date])
  @@index([assignedToId])
}

enum HousekeepingStatus {
  DIRTY
  CLEANING
  INSPECTED
  READY
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
}

model MaintenanceTicket {
  id           String                  @id @default(uuid())
  room         Room?                   @relation(fields: [roomId], references: [id]) // nullable — a ticket can be for a common area, not every issue is room-specific
  roomId       String?
  category     String // free text (AC, plumbing, electrical...) — hotels categorize differently, not worth an enum yet
  priority     TaskPriority            @default(NORMAL)
  description  String
  status       MaintenanceStatus       @default(OPEN)
  assignedTo   Staff?                  @relation(fields: [assignedToId], references: [id])
  assignedToId String?
  repairCost   Int?                    // rupees — filled when resolved, null until then; never guessed/defaulted to 0
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([assignedToId])
}

enum MaintenanceStatus {
  OPEN
  ASSIGNED
  IN_PROGRESS
  WAITING
  RESOLVED
  CLOSED
}

// Single row per property (v1 is one property, not a chain) — hotel's own details
// for GST invoices and the Settings > Property tab. Enforced as a singleton in
// settingsService (always reads/writes the one row), not at the schema level —
// Postgres has no clean native "at most one row" constraint worth the complexity here.
model PropertySettings {
  id         String   @id @default(uuid())
  hotelName  String
  address    String
  gstNumber  String?
  phone      String?
  updatedAt  DateTime @updatedAt
}
