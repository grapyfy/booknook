// The database's real schema. Changes here go through `npm run db:migrate`,
// which creates a tracked, numbered migration file — never hand-edit the database directly.
// This is the fix for the exact mistake made on the last project: schema changes patched
// live in prod with one-off scripts instead of tracked migrations. See CLAUDE.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// One row per staff login. `supabaseUserId` links to Supabase Auth's own user record —
// that's what actually handles passwords/sessions; this table just says who they are
// and what they're allowed to do once logged in.
model Staff {
  id             String    @id @default(uuid())
  supabaseUserId String    @unique
  name           String
  email          String    @unique
  role           StaffRole
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
}

// All 6 roles from the PRD are listed so the schema doesn't need a migration later —
// but only OWNER and FRONT_DESK are actually assignable/enforced in v1. The other 4
// have no corresponding screens yet (housekeeping, accountant reports aren't built),
// so there's nothing for them to do — don't build permission checks for unused roles.
enum StaffRole {
  OWNER // combines PRD's Super Admin + Property Manager for v1 (single property, no chain yet)
  FRONT_DESK
  ACCOUNTANT // reserved — no accountant-only screens built yet
  HOUSEKEEPING_SUPERVISOR // reserved — housekeeping module not built yet
  HOUSEKEEPING_STAFF // reserved — housekeeping module not built yet
}

model Guest {
  id       String    @id @default(uuid())
  name     String
  phone    String
  email    String?
  bookings Booking[]

  @@index([phone])
}

model Booking {
  id              String   @id @default(uuid())
  guest           Guest    @relation(fields: [guestId], references: [id])
  guestId         String
  checkIn         DateTime
  checkOut        DateTime
  roomNumber      String
  status          BookingStatus @default(CONFIRMED)
  roomRatePerNight Int     // rupees per night — the GST slab (12%/18%) depends on THIS, not the total
  amount          Int      // roomRatePerNight * nights, always computed server-side — never accepted from the client
  createdAt       DateTime @default(now())
  folio           Folio?

  @@index([guestId])
  @@index([checkIn, checkOut])
}

enum BookingStatus {
  CONFIRMED
  CHECKED_IN
  CHECKED_OUT
  CANCELLED
}

// One GST-compliant bill per booking. Numbers are stored, not recomputed on read —
// a GST rate change in the future must never alter an already-issued invoice.
model Folio {
  id            String   @id @default(uuid())
  booking       Booking  @relation(fields: [bookingId], references: [id])
  bookingId     String   @unique
  invoiceNumber String   @unique
  sacCode       String   @default("996311") // Accommodation services — fixed for this business type
  baseAmount    Int      // pre-tax, rupees
  gstRate       Int      // 12 or 18, based on roomRatePerNight at the time of billing
  gstType       GstType  // CGST_SGST (intra-state) or IGST (inter-state)
  cgst          Int      // 0 if gstType is IGST
  sgst          Int      // 0 if gstType is IGST
  igst          Int      // 0 if gstType is CGST_SGST
  totalAmount   Int      // baseAmount + tax
  createdAt     DateTime @default(now())
}

enum GstType {
  CGST_SGST
  IGST
}
