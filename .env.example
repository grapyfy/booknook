# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Project Settings > Database in the Supabase dashboard)
# DATABASE_URL = "Transaction pooler" connection string (used at runtime).
#                MUST end with "?pgbouncer=true" — without it you'll intermittently hit
#                "prepared statement already exists" errors under real usage.
# DIRECT_URL   = normally "Direct connection", but that needs IPv6 — if your network is
#                IPv4-only (most home/office wifi) and you get "Can't reach database server",
#                use the "Session pooler" string instead (same host as Transaction pooler, port 5432).
# Also: the Prisma CLI (migrations) only reads a file literally named `.env` — Next.js reads
# `.env.local`. Put DATABASE_URL/DIRECT_URL in BOTH, or at minimum in `.env` for migrations to work.
DATABASE_URL=
DIRECT_URL=

# Razorpay — BYOG model: these are OUR platform's own test keys for now.
# Each hotel's own keys get added later, per-hotel, once that flow is built.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
