# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Supabase project settings (Project Settings > API in the Supabase dashboard)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Database (Project Settings > Database in the Supabase dashboard)
# DATABASE_URL = pooled connection (used at runtime)
# DIRECT_URL   = direct connection (used only when running migrations)
DATABASE_URL=
DIRECT_URL=

# Razorpay — BYOG model: these are OUR platform's own test keys for now.
# Each hotel's own keys get added later, per-hotel, once that flow is built.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
